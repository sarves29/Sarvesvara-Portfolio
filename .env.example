# Copy to .env (chmod 600) and fill in. Never commit .env.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
SITE_URL=https://example.com

# Gemini — powers the "Ask about me" AI chat and resume parsing in the admin
GOOGLE_API_KEY=

# SendGrid — contact form
SENDGRID_API_KEY=
PORTFOLIO_CONTACT_FROM=       # a SendGrid-verified sender
PORTFOLIO_CONTACT_TO=

# /now page — recent public GitHub activity
PORTFOLIO_GITHUB_USERNAME=

# Optional Umami analytics
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# create_superuser.py — no default password on purpose
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
