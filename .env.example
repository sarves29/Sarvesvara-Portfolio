# Copy to .env and fill in. Never commit .env.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=            # python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Contact form (SendGrid)
SENDGRID_API_KEY=
CONTACT_FROM_EMAIL=           # a SendGrid-verified sender
CONTACT_TO_EMAIL=
CONTACT_RATE_LIMIT=5          # messages per IP per hour

# Resume -> projects (Gemini), optional
GOOGLE_API_KEY=

# create_superuser.py (no defaults on purpose)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
